# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local MongoDB: mongodb://127.0.0.1:27017/lostlink
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/lostlink?retryWrites=true&w=majority
# If left empty or set to 'inmemory', an automatic in-memory MongoDB will be used for testing and seamless local dev.
MONGODB_URI=mongodb://127.0.0.1:27017/lostlink

# Authentication
JWT_SECRET=lostlink_super_secure_jwt_secret_key_campus_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Initial Administrator Seed Credentials (used by seed script)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@lostlink.edu
ADMIN_PASSWORD=Admin@LostLink2026!
ADMIN_INSTITUTION=Central University Campus
