{
  "name": "lostlink",
  "version": "1.0.0",
  "description": "LostLink - Smart Lost-and-Found Management Platform for Campuses and Educational Institutions",
  "type": "module",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/src/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "node server/src/seed.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "lost-and-found",
    "campus",
    "full-stack",
    "mern",
    "mongodb",
    "express",
    "react",
    "node"
  ],
  "author": "LostLink Team",
  "license": "ISC"
}
